# Copy to .env and customize. All of these have sane defaults if omitted.

# Port on the HOST machine to expose the app on.
HOST_PORT=8080

# VM resources.
QEMU_RAM=2048
QEMU_CORES=2

# Set to 1 to use KVM hardware acceleration (Linux host with /dev/kvm only).
# Also uncomment the `devices: - /dev/kvm` line in docker-compose.yml.
QEMU_KVM=0

# Strongly recommended before exposing this to the public internet --
# TempleOS has no login/permission model at all, and the VM is shared by
# every visitor. Leave both blank to disable (fine for local/private use).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
